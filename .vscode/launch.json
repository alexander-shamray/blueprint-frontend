{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      // 5173, not Angular's default 4200: angular.json pins the dev server to
      // it because the backend's Compose file (Cors__Origins__0) and the realm's
      // web-app client (redirectUris, webOrigins) both name 5173 and nothing
      // else. A debug session launched against 4200 loads the app and then
      // cannot sign in.
      "url": "http://localhost:5173/"
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ]
}
