/* The type-check for e2e/ and the Playwright config. Playwright transpiles the
   specs it loads and never type-checks them, and ng lint reads no types, so
   npm run lint runs tsc over this file (#253). allowImportingTsExtensions is
   for native-stream.mts, which Node runs as it is and so imports .ts files
   by their real names. It lives here and not at the root because a tracked
   root file is a decision for the harness deny lists. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.mts", "../playwright.config.ts"]
}
