{
  "name": "blueprint-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:android": "ng build --configuration android",
    "emulator:android": "ng build --configuration android && cap sync android",
    "emulator:android:run": "cap run android --no-sync",
    "emulator:android:run:windows": "cd android && gradlew.bat installDebug && adb shell am start -n dev.ashamray.blueprint/.MainActivity",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && tsc -p e2e/tsconfig.json",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@ionic/angular": "9.0.3",
    "angular-oauth2-oidc": "22.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@ionic/angular-toolkit": "13.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "22.5.0",
    "eslint": "10.10.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.12"
  }
}
