{
  "permissions": {
    "deny": [
      "Edit(.claude/skills/**)",
      "Edit(./.claude/skills/**)",
      "Edit(.claude/hooks/**)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" index-refresh.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
