{
  "permissions": {
    "deny": [
      "Edit(.claude/skills/**)",
      "Edit(./.claude/skills/**)",
      "Edit(.claude/hooks/**)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && bash .claude/skills/codebase-index/scripts/run-index update >/dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
