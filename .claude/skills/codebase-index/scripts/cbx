#!/usr/bin/env bash
# Thin, safe wrapper around the installed `codebase-index` CLI.
# - Resolves the binary (prefers one on PATH; falls back to `python -m codebase_index`).
# - Whitelists subcommands so the skill can never invoke destructive ones (clean/init/watch).
set -euo pipefail
export CBX_NO_SKILL_AUTO_UPDATE=1
# The fallbacks below run `python -m` and `-c` from the caller's directory,
# which puts that directory first on `sys.path`, so a `codebase_index.py`
# there would be imported in the package's place. `PYTHONSAFEPATH` stops that
# from Python 3.11, and each probe holds its interpreter to the hooks' 3.12
# floor before it imports anything (alexander-shamray/blueprint-frontend#151).
export PYTHONSAFEPATH=1
probe='import sys; sys.version_info >= (3, 12) or sys.exit(1); import codebase_index'

ALLOWED="search explain architecture symbol refs impact diff-impact path describe verify graph stats doctor update index"

sub="${1:-}"
case " $ALLOWED " in
  *" ${sub} "*) : ;;
  *)
    echo "cbx: refusing subcommand '${sub}'. Allowed: ${ALLOWED}" >&2
    exit 2
    ;;
esac

# Judge the index before the CLI opens it (#138): a rollback journal or a link
# a branch tracked under .claude/cache/codebase-index/ is refused, not replayed.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$here/gate.sh"
gate_index "$here" || exit $?

if command -v codebase-index >/dev/null 2>&1; then
  exec codebase-index "$@"
elif command -v py >/dev/null 2>&1 && py -3.12 -c "$probe" >/dev/null 2>&1; then
  exec py -3.12 -m codebase_index "$@"
elif command -v python3 >/dev/null 2>&1 && python3 -c "$probe" >/dev/null 2>&1; then
  exec python3 -m codebase_index "$@"
elif command -v python >/dev/null 2>&1 && python -c "$probe" >/dev/null 2>&1; then
  exec python -m codebase_index "$@"
else
  echo "cbx: codebase-index is not on PATH and no Python 3.12+ can import it" >&2
  exit 127
fi
