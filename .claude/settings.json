{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Grep",
      "Glob",
      "Read"
    ],
    "deny": [
      "Edit(.remember/**)",
      "Edit(./.remember/**)",
      "Edit(.claude/scripts/**)",
      "Edit(./.claude/scripts/**)",
      "Edit(.claude/commands/**)",
      "Edit(./.claude/commands/**)",
      "Edit(.claude/agents/**)",
      "Edit(./.claude/agents/**)",
      "Edit(.claude/hooks/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(.claude/skills/**)",
      "Edit(./.claude/skills/**)",
      "Edit(.claude/settings.json)",
      "Edit(./.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(AGENTS.md)",
      "Edit(./AGENTS.md)",
      "Edit(.github/**)",
      "Edit(./.github/**)",
      "Edit(package.json)",
      "Edit(./package.json)",
      "Edit(**/package.json)",
      "Edit(.npmrc)",
      "Edit(./.npmrc)",
      "Edit(**/.npmrc)",
      "Edit(angular.json)",
      "Edit(./angular.json)",
      "Edit(tsconfig.json)",
      "Edit(./tsconfig.json)",
      "Edit(tsconfig.app.json)",
      "Edit(./tsconfig.app.json)",
      "Edit(tsconfig.spec.json)",
      "Edit(./tsconfig.spec.json)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/*.config.cjs)",
      "Edit(**/*.config.mjs)",
      "Edit(**/vitest.config.ts)",
      "Edit(**/vite.config.ts)",
      "Edit(**/playwright.config.ts)",
      "Edit(**/capacitor.config.ts)",
      "Edit(**/*.config.mts)",
      "Edit(node_modules/**)",
      "Edit(./node_modules/**)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin HEAD:main:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch --move:*)",
      "Bash(git branch --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(git worktree remove:*)",
      "Bash(git *--output*)",
      "Bash(git *--no-index*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git *--exec*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-git-argv.py",
            "statusMessage": "checking git argv"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" guard-edit-target.py",
            "statusMessage": "checking edit target"
          }
        ]
      },
      {
        "matcher": "Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" index-search-hint.py || :",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__codebase-index__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" index-mcp-root.py || :",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" index-refresh.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" index-refresh.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\" index-query-hint.py || :",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
